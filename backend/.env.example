# ============================================
# XetaCart Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# On Vercel, add these same keys under Project Settings -> Environment Variables.
# ============================================

# Server port (used for local dev only; Vercel ignores this)
PORT=5000

# --- Supabase (database + storage) ---
SUPABASE_URL=your-project-url.supabase.co
# Service role key (server-side, full access). Use this, NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: override the storage bucket name (defaults to "product-images")
SUPABASE_STORAGE_BUCKET=product-images

# JWT signing secret (use a long random string in production)
JWT_SECRET=change_this_in_production

# --- Seller account (auto-created on first startup) ---
SELLER_EMAIL=santushils16@gmail.com
# In production this MUST be set (no insecure default is used).
SELLER_PASSWORD=your_strong_seller_password
SELLER_NAME=XetaCart Store
SELLER_PHONE=6033571851
# WhatsApp number for orders, international format WITHOUT '+'
SELLER_WHATSAPP=916033571851

# --- Store details (shown to customers) ---
STORE_ADDRESS=Jalefa Bazar, Sabroom, South Tripura, 799145
STORE_MAPS_URL=https://maps.app.goo.gl/ot4F6KvMi8ZVJi8c6
STORE_LAT=23.1640
STORE_LNG=91.7380
DELIVERY_RADIUS_KM=3

# --- Delivery / payment notes (optional reference values) ---
# Delivery charges are now confirmed by the seller via WhatsApp, so these
# are optional informational defaults only.
DELIVERY_CHARGE=30
FREE_DELIVERY_THRESHOLD=500
PAYMENT_NOTE=Pay after your order is confirmed. The seller will share a QR code via WhatsApp for payment.
