# ============================================
# XetaCart Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase (required) ---
# Get these from your Supabase project: Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OR use one of these alternatives:
# SUPABASE_SECRET_KEY=
# SUPABASE_ANON_KEY=

# --- Supabase Storage bucket for product images ---
# Optional. Defaults to "product-images". Create this bucket in Supabase Storage (public bucket).
SUPABASE_STORAGE_BUCKET=product-images

# --- JWT Secret (use a long random string in production) ---
JWT_SECRET=change-this-to-a-long-random-secret-string

# --- Seller account (used to log into the Seller Panel) ---
SELLER_EMAIL=santushils16@gmail.com
SELLER_PASSWORD=Santu@321
SELLER_NAME=XetaCart Store
SELLER_PHONE=6033571851

# --- WhatsApp number (international format, no '+') ---
SELLER_WHATSAPP=916033571851

# --- Store config ---
STORE_ADDRESS=Jalefa Bazar, Sabroom, South Tripura, 799145

# --- Frontend (for Vite build) ---
# Leave empty to use the same-domain /api on Vercel.
# For local dev pointing to a different backend, set your backend URL.
VITE_API_URL=/api
