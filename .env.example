# ============================================
# XetaCart Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase (required) ---
# Get these from your Supabase project: Dashboard > Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# --- Supabase Storage bucket for product images ---
# Optional. Defaults to "product-images". Create this bucket in Supabase Storage (public bucket).
SUPABASE_STORAGE_BUCKET=product-images

# --- JWT Secret (generate: openssl rand -base64 48) ---
JWT_SECRET=your-64-char-base64-secret-here
REFRESH_SECRET=your-64-char-base64-refresh-secret-here

# --- Seller account ---
SELLER_EMAIL=your-store-email@example.com
SELLER_PASSWORD=your-strong-random-password-here
SELLER_NAME=Your Store Name
SELLER_PHONE=your-phone-number

# --- WhatsApp number (international format, no '+') ---
SELLER_WHATSAPP=your-whatsapp-number

# --- Store config ---
STORE_ADDRESS=Your Store Address
STORE_MAPS_URL=https://maps.app.goo.gl/your-store-location
STORE_LAT=0.0000
STORE_LNG=0.0000
DELIVERY_RADIUS_KM=3
DELIVERY_CHARGE=30
FREE_DELIVERY_THRESHOLD=500

# --- Payment note ---
PAYMENT_NOTE=Pay after your order is confirmed. The seller will share a QR code via WhatsApp for payment.

# --- Frontend (for Vite build) ---
# Leave empty to use the same-domain /api on Vercel.
# For local dev pointing to a different backend, set your backend URL.
VITE_API_URL=/api

# --- CORS ---
# Comma-separated list of allowed origins (e.g., https://your-domain.vercel.app,http://localhost:5173)
ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:5173